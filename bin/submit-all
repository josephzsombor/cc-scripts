#!/bin/bash

# Directory containing the .inp files (default: current directory)
DIR="${1:-.}"

# Loop through all .inp files in the directory
for file in "$DIR"/*.inp; do
    if [[ -f "$file" ]]; then
        base=$(basename "$file")
        echo "Submitting $base..."
        sbatch -J "$base" "$HOME/bin/orca_sub.sh" "$base"
    fi
done
